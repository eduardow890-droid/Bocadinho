# Copie para .env e preencha. NUNCA suba o .env para o GitHub.
PORT=3000
NODE_ENV=development
# Ative apenas para testar o fluxo sem cobrar no Mercado Pago.
PAGAMENTO_SIMULADO=false

# URL pública (HTTPS) onde o servidor está acessível. Em testes locais use a URL do ngrok.
BASE_URL=https://seu-tunel.ngrok-free.app

# Mercado Pago > Suas integrações > sua aplicação
MP_ACCESS_TOKEN=coloque_o_access_token_aqui
# Mercado Pago > Webhooks > Configurar notificações > chave secreta
MP_WEBHOOK_SECRET=coloque_a_chave_secreta_aqui

# Token para as rotas /api/admin (gere algo longo e aleatório)
ADMIN_TOKEN=troque-por-um-token-longo-e-aleatorio

# Validade do Pix em minutos (mínimo 30)
PIX_EXPIRA_MIN=30
# Supabase: Connect > Session pooler (IPv4) > URI
DATABASE_URL=postgresql://postgres.PROJECT_REF:SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres?sslmode=require
# Em produção, envie o certificado raiz baixado em Supabase > Database Settings > SSL Configuration
# ao Render como Secret File e configure DB_SSL_CA=/etc/secrets/supabase-prod-ca-2021.crt.
DB_SSL_CA=
